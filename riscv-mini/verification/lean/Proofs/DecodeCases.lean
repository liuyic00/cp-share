import Proofs.ControlAlignment
import Proofs.MaskFacts
namespace RiscvMiniProofs
-- Instruction masks constrain only opcode/function bits, not operands or immediate.
-- No instruction-class predicate is added to the global environment.
private theorem lui_decode_v7303 (instruction : BitVec 32)
    (known : instruction &&& 127 = 55) : decode_v7303 instruction = 1 := by
  change (if (55 : BitVec 32) = (instruction &&& 127) then 1 else 0) = 1
  have yes : instruction &&& 127 = 55 :=
    mask_refines instruction 127 55 127 known (by decide)
  rw [if_pos yes.symm]

private theorem lui_decode_v7307 (instruction : BitVec 32)
    (known : instruction &&& 127 = 55) : decode_v7307 instruction = 0 := by
  change (if (23 : BitVec 32) = (instruction &&& 127) then 1 else 0) = 0
  have no : instruction &&& 127 ≠ 23 :=
    mask_incompatible instruction 127 55 127 23 known (by decide)
  rw [if_neg (Ne.symm no)]

