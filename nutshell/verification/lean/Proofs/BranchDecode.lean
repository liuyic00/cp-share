import Proofs.ImmediateEncoding
import Proofs.DecodeBits
namespace NutShellProofs
open nNutCore
set_option maxRecDepth 4096
set_option maxHeartbeats 1000000
set_option linter.unusedSimpArgs false

inductive BranchOp where
  | beq | bne | blt | bge | bltu | bgeu
  deriving DecidableEq

def BranchOp.encoding : BranchOp → BitVec 64
  | .beq => 99
  | .bne => 4195
  | .blt => 16483
  | .bge => 20579
  | .bltu => 24675
  | .bgeu => 28771

def BranchOp.control : BranchOp → BitVec 7
  | .beq => 16
  | .bne => 17
  | .blt => 20
  | .bge => 21
  | .bltu => 22
  | .bgeu => 23

def BranchOp.mask (_ : BranchOp) : BitVec 64 := 28799

def IsBranch (op : BranchOp) (instr : BitVec 64) : Prop :=
  instr &&& op.mask = op.encoding

